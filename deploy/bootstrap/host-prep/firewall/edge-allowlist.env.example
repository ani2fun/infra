# Operator-specific firewall settings for vm-1's public nftables allowlist.
# Copy this file to /etc/edge-allowlist.env and fill in the placeholder.
# DO NOT commit the filled-in version to Git.
#
# prepare-host.sh reads ADMIN_SSH_ALLOW_IP from here and generates
# /etc/nftables.d/00-edge-allowlist.nft:
#
#     define ADMIN_SSH_ALLOW_IP = <value>
#
# The glob in /etc/nftables.conf includes that file before edgeguard.nft
# (alphabetical order), so the `ip saddr $ADMIN_SSH_ALLOW_IP tcp dport 22
# accept` rule in the `inet edgeguard` table resolves against it. This is the
# ONLY place the SSH allowlist is enforced.
#
# Note: edge-guardrail.sh does NOT read this value. Its `inet edge_guardrail`
# table accepts `tcp dport 22` on eth0 from anywhere by design -- it sits at
# hook priority -50, behind edgeguard at -200, and is defence-in-depth for the
# other ports. If edgeguard is missing, SSH is open to the internet.
#
# If this value is wrong on rebuild day, you will be locked out of SSH on
# vm-1 -- access will require Contabo's web console.

# The home IP from which the operator administers the cluster. CIDR /32 only.
# Look it up at https://ifconfig.me before applying.
ADMIN_SSH_ALLOW_IP=<<REPLACE_WITH_OPERATOR_HOME_IP>>
